<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/auto"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AnonChatApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AnonChat"
        tools:targetApi="35">

        <!--
          allowBackup="false": prevents Android auto-backup from copying the
          encrypted session store / any cached app data off-device via
          Google's backup service — keep all persistence under our own
          Keystore-backed encryption, not device backup.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AnonChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
